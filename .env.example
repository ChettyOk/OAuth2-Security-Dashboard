PORT=3000
APP_BASE_URL=http://localhost:3000
ACCESS_TOKEN_AUDIENCE=oauth2-demo-resource
NODE_ENV=development
TRUST_PROXY=1
SESSION_SECURE_COOKIE=false
RATE_LIMIT_WINDOW_MS=60000
